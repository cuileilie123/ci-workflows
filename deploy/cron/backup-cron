# ============================================================
# 社区邻里有偿互助平台 - 备份 Cron 配置
# ============================================================
#
# 注意：Cron 不会自动加载 .env 文件
# 如果修改了密码或数据库配置，需要同步更新此文件中的环境变量
#
# 编辑方式:
#   1. 修改此文件中的 MYSQL_PASSWORD 等变量
#   2. 重启备份调度器: docker compose -f docker-compose.backup.yml restart
#
# 日志文件:
#   /var/log/backup.log          - 全量备份日志
#   /var/log/binlog-backup.log   - 增量备份日志
#   /var/log/verify.log          - 完整性验证日志
#   /var/log/cleanup.log         - 清理日志
#   /backup/mysql/backup_log.csv - 备份记录表
#
# ============================================================

# ---- 环境变量（Cron 专用）----
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# MySQL 连接（需与 docker-compose.backup.yml 保持一致）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=neighborhood_help

# 备份路径
BACKUP_DIR=/backup/mysql

# 腾讯云 COS（可选，如不需要云端备份可留空）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=neighborhood-help-1250000000
COS_REGION=ap-guangzhou

# 时区
TZ=Asia/Shanghai

# ---- 定时任务 ----

# 每日 03:00 全量备份（mysqldump + gzip + COS 上传）
0 3 * * * root bash /scripts/backup.sh >> /var/log/backup.log 2>&1

# 每 6 小时增量备份（Binlog flush + 文件复制）
0 */6 * * * root bash /scripts/binlog-backup.sh >> /var/log/binlog-backup.log 2>&1

# 每周日 04:00 验证最近备份的完整性
0 4 * * 0 root bash /scripts/verify-backup.sh >> /var/log/verify.log 2>&1

# 每月 1 号 05:00 清理 30 天前的旧备份
0 5 1 * * root bash /scripts/cleanup-old-backups.sh >> /var/log/cleanup.log 2>&1
