{
  "name": "neighborhood-help",
  "version": "0.1.0",
  "private": true,
  "description": "社区邻里有偿互助平台 - 微信小程序 + NestJS BFF + Go/Java 微服务",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev:mp-weixin",
    "dev:bff": "pnpm --filter bff start:dev",
    "build:frontend": "pnpm --filter frontend build:mp-weixin",
    "build:bff": "pnpm --filter bff build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test-finance": "node scripts/test-boss-finance-settings.cjs",
    "cleanup:test-data": "node scripts/cleanup-test-data.cjs",
    "cleanup:test-data:force": "node scripts/cleanup-test-data.cjs --confirm -y",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "miniprogram-automator": "^0.12.1"
  }
}
