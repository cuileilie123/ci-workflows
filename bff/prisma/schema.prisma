// ============================================================
// 社区邻里有偿互助平台 - 完整数据模型
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== 用户 =====
model User {
  id          BigInt     @id @default(autoincrement())
  openid      String     @unique @map("openid")
  phone       String?    @db.VarChar(20)
  nickname    String     @db.VarChar(64)
  avatar      String?    @db.VarChar(512)
  creditScore Int        @default(100) @map("credit_score")
  role        Role       @default(USER)
  status      UserStatus @default(ACTIVE)
  deviceFp    String?    @map("device_fp") @db.VarChar(64)
  lastLoginAt DateTime?  @map("last_login_at")
  loginCount  Int        @default(0) @map("login_count")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  publishedTasks  Task[]    @relation("Publisher")
  acceptedTasks   Task[]    @relation("Helper")
  wallet          Wallet?
  sentReviews     Review[]  @relation("Reviewer")
  receivedReviews Review[]  @relation("Reviewee")
  orders          Order[]   @relation("HelperOrders")
  staffPermissions StaffPermission[]
  grantedPermissions StaffPermission[] @relation("Granter")
  bankCards       BankCard[]
  realNameVerification RealNameVerification?

  @@index([creditScore])
  @@index([role])
  @@index([status])
  @@map("users")
}

enum Role {
  USER
  HELPER
  ADMIN
  SUPER_ADMIN
  BOSS
  STAFF
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
}

// ===== 任务 =====
model Task {
  id          BigInt      @id @default(autoincrement())
  publisherId BigInt      @map("publisher_id")
  helperId    BigInt?     @map("helper_id")
  title       String      @db.VarChar(100)
  description String      @db.Text
  price       Decimal     @db.Decimal(10, 2)
  lat         Decimal     @db.Decimal(10, 7)
  lng         Decimal     @db.Decimal(10, 7)
  geohash     String      @db.VarChar(12)
  address     String      @db.VarChar(256)
  categoryId  BigInt      @map("category_id")
  urgency     Urgency     @default(NORMAL)
  images      Json        @default("[]")
  status      TaskStatus  @default(OPEN)
  expireAt    DateTime    @map("expire_at")
  viewCount   Int         @default(0) @map("view_count")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  publisher User         @relation("Publisher", fields: [publisherId], references: [id])
  helper    User?        @relation("Helper", fields: [helperId], references: [id])
  category  TaskCategory @relation(fields: [categoryId], references: [id])
  orders    Order[]
  priceModifications PriceModification[]

  @@index([geohash])
  @@index([status, expireAt])
  @@index([publisherId])
  @@index([helperId])
  @@index([categoryId, status])
  @@index([categoryId, status, urgency, createdAt(sort: Desc)])
  @@map("tasks")
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskCategoryLegacy {
  DELIVERY
  SHOPPING
  CLEANING
  REPAIR
  TUTORING
  PET_CARE
  MOVING
  OTHER
}

// ===== 任务类别（可配置） =====
model TaskCategory {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(32) // 唯一业务编码，如 DELIVERY
  name      String   @db.VarChar(32) // 显示名称，如 跑腿送货
  icon      String?  @db.VarChar(256) // 图标 URL
  sort      Int      @default(0) // 排序，升序
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks              Task[]
  profitSharingRules ProfitSharingRule[]

  @@index([isActive, sort])
  @@map("task_categories")
}

// ===== 分账规则 =====
// 规则优先级：categoryId 精确匹配 > 全局默认 (categoryId IS NULL)
// 生效条件：isActive = true 且 (validFrom IS NULL OR validFrom <= now) 且 (validTo IS NULL OR validTo > now)
model ProfitSharingRule {
  id            BigInt    @id @default(autoincrement())
  name          String    @db.VarChar(64) // 规则名称
  categoryId    BigInt?   @map("category_id") // 绑定的任务类别；空 = 全局默认规则
  mode          String    @default("FLAT") @db.VarChar(10) @map("mode") // FLAT=单一比例, TIERED=分段抽佣
  platformRate  Decimal   @db.Decimal(5, 4) @map("platform_rate") // 平台抽成比例（FLAT 模式使用），0.1000 = 10%
  helperRate    Decimal   @db.Decimal(5, 4) @map("helper_rate") // 接单者分成比例（FLAT 模式使用），0.9000 = 90%
  tiers         Json?     @map("tiers") // 分段抽佣配置 [{rangeStart, rangeEnd, platformRate}]（TIERED 模式使用）
  minPlatformFee Decimal? @db.Decimal(10, 2) @map("min_platform_fee") // 最低平台抽成（元，FLAT 模式使用）
  maxPlatformFee Decimal? @db.Decimal(10, 2) @map("max_platform_fee") // 最高平台抽成（元，FLAT 模式使用）
  isActive      Boolean   @default(true) @map("is_active")
  validFrom     DateTime? @map("valid_from")
  validTo       DateTime? @map("valid_to")
  priority      Int       @default(0) // 同条件下优先级大的先匹配
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  category TaskCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId, isActive])
  @@index([isActive, priority(sort: Desc)])
  @@map("profit_sharing_rules")
}

enum TaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PRICE_PENDING
  EXPIRED
}

// ===== 订单 =====
model Order {
  id           BigInt      @id @default(autoincrement())
  orderNo      String     @unique @db.VarChar(10) @map("order_no") // 订单号：2大写字母+8数字，便于中台检索
  taskId       BigInt      @map("task_id")
  helperId     BigInt      @map("helper_id")
  totalAmount  Decimal     @db.Decimal(10, 2) @map("total_amount")
  platformFee  Decimal     @db.Decimal(10, 2) @map("platform_fee")
  status       OrderStatus @default(PENDING)
  isSupplement Boolean     @default(false) @map("is_supplement")
  paidAt       DateTime?   @map("paid_at")
  completedAt  DateTime?   @map("completed_at")
  refundAmount Decimal?    @db.Decimal(10, 2) @map("refund_amount")
  refundReason String?     @db.VarChar(500) @map("refund_reason")
  quoteExpiresAt DateTime? @map("quote_expires_at")
  rejectedAt   DateTime?   @map("rejected_at")
  rejectReason String?     @db.VarChar(500) @map("reject_reason")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  task         Task          @relation(fields: [taskId], references: [id])
  helper       User          @relation("HelperOrders", fields: [helperId], references: [id])
  review       Review?
  transactions Transaction[]
  refundRequest RefundRequest?

  @@index([taskId])
  @@index([helperId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([helperId, status])
  @@index([status, helperId])
  @@index([isSupplement])
  @@map("orders")
}

enum OrderStatus {
  BIDDING
  PENDING
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
  REFUND_PENDING
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ===== 退款申请 =====
model RefundRequest {
  id          BigInt       @id @default(autoincrement())
  orderId     BigInt       @unique @map("order_id")
  userId      BigInt       @map("user_id")
  amount      Decimal      @db.Decimal(10, 2)
  reason      String?      @db.VarChar(500)
  status      RefundStatus @default(PENDING)
  refundId    String?      @db.VarChar(64) @map("refund_id")
  requestedAt DateTime     @default(now()) @map("requested_at")
  processedAt DateTime?    @map("processed_at")
  failReason  String?      @db.VarChar(500) @map("fail_reason")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([requestedAt])
  @@index([userId])
  @@map("refund_requests")
}

// ===== 钱包 =====
model Wallet {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  frozen    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("wallets")
}

// ===== 交易流水（复式记账） =====
model Transaction {
  id           BigInt          @id @default(autoincrement())
  walletId     BigInt          @map("wallet_id")
  orderId      BigInt?         @map("order_id")
  type         TransactionType
  amount       Decimal         @db.Decimal(10, 2)
  balanceAfter Decimal         @db.Decimal(12, 2) @map("balance_after")
  description  String          @db.VarChar(255)
  createdAt    DateTime        @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
  FREEZE
  UNFREEZE
}

// ===== 评价 =====
model Review {
  id         BigInt   @id @default(autoincrement())
  orderId    BigInt   @unique @map("order_id")
  reviewerId BigInt   @map("reviewer_id")
  revieweeId BigInt   @map("reviewee_id")
  rating     Int
  tags       Json     @default("[]")
  comment    String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  order    Order @relation(fields: [orderId], references: [id])
  reviewer User  @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee User  @relation("Reviewee", fields: [revieweeId], references: [id])

  @@index([revieweeId])
  @@index([rating])
  @@index([revieweeId, createdAt(sort: Desc)])
  @@map("reviews")
}

// ===== 审计日志 =====
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  adminId    BigInt?  @map("admin_id")
  action     String   @db.VarChar(64)
  targetType String   @db.VarChar(32) @map("target_type")
  targetId   BigInt   @map("target_id")
  detail     Json?
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===== 工作人员权限（老板授权给工作人员的细粒度权限） =====
model StaffPermission {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  permission  String   @db.VarChar(64) // PROFIT_SHARING_MANAGE | ORDER_PRICE_MANAGE | TASK_CATEGORY_MANAGE
  grantedBy   BigInt?  @map("granted_by")
  grantedAt   DateTime @default(now()) @map("granted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User   @relation(fields: [userId], references: [id])
  granter User?  @relation("Granter", fields: [grantedBy], references: [id])

  @@unique([userId, permission])
  @@index([userId])
  @@index([permission])
  @@map("staff_permissions")
}

// ===== 订单改价记录（工作人员修改订单价格，待发布者确认） =====
model PriceModification {
  id          BigInt                 @id @default(autoincrement())
  taskId      BigInt                 @map("task_id")
  staffId     BigInt                 @map("staff_id")
  oldPrice    Decimal                @db.Decimal(10, 2) @map("old_price")
  newPrice    Decimal                @db.Decimal(10, 2) @map("new_price")
  reason      String?                @db.VarChar(500)
  previousStatus TaskStatus          @map("previous_status")
  status      PriceModificationStatus @default(PENDING)
  confirmedAt DateTime?              @map("confirmed_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@index([status])
  @@map("price_modifications")
}

enum PriceModificationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// ===== 敏感词 =====
model SensitiveWord {
  id        BigInt   @id @default(autoincrement())
  word      String   @unique @db.VarChar(64)
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sensitive_words")
}

// ===== 优惠券 =====
model Coupon {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(32)
  type      String   @db.VarChar(16)
  value     Decimal  @db.Decimal(10, 2)
  minAmount Decimal  @default(0) @map("min_amount") @db.Decimal(10, 2)
  validFrom DateTime @map("valid_from")
  validTo   DateTime @map("valid_to")
  usedCount Int      @default(0) @map("used_count")
  maxUsage  Int      @default(100) @map("max_usage")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([validTo])
  @@map("coupons")
}

// ===== 平台财务设置（单例：id=1，仅老板账号可编辑） =====
// 收款账号配置保存后，微信支付回调触发分账时会从这里读取接收方，
// 优先级高于 .env 里的 WX_PROFIT_SHARING_*（DB 未配置时才回落到 env）。
model PlatformFinanceSetting {
  id                     BigInt    @id @default(autoincrement())
  // ---------- 平台佣金收款账号（分账接收方，独立商户号）----------
  // 是否启用分账：开关，总控，关闭则不分账（钱留在主商户号）
  profitSharingEnabled   Boolean   @default(true) @map("profit_sharing_enabled")
  // 接收方类型：MERCHANT_ID = 微信支付商户号（推荐）；PERSONAL_OPENID = 个人零钱（需额外验证）
  receiverType           String    @default("MERCHANT_ID") @map("receiver_type") @db.VarChar(20)
  // 接收方商户号（receiverType=MERCHANT_ID 时必填，如 1600000000）
  receiverMchId          String?   @map("receiver_mch_id") @db.VarChar(32)
  // 接收方名称（微信商户平台登记的主体名称，如 XX 科技有限公司）
  receiverName           String?   @map("receiver_name") @db.VarChar(128)
  // 接收方个人 openid（receiverType=PERSONAL_OPENID 时必填）
  receiverOpenid         String?   @map("receiver_openid") @db.VarChar(64)
  // ---------- 主商户号（可选覆盖 env，方便老板配置，不必找运维改配置文件）----------
  // 主商户号：如 1600000001；为空则回落到 env.WX_MCH_ID
  mainMchId              String?   @map("main_mch_id") @db.VarChar(32)
  // 小程序 AppID；为空则回落到 env.WX_APP_ID
  mainAppId              String?   @map("main_app_id") @db.VarChar(32)
  // ---------- 元数据 ----------
  updatedBy              BigInt?   @map("updated_by")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@map("platform_finance_settings")
}

// ===== 客服工单 =====
model Ticket {
  id           BigInt       @id @default(autoincrement())
  userId       BigInt       @map("user_id")
  adminId      BigInt?      @map("admin_id")
  subject      String       @db.VarChar(128)
  content      String       @db.Text
  status       TicketStatus @default(OPEN)
  priority     Int          @default(3)
  satisfaction Int?         @map("satisfaction")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  closedAt     DateTime?    @map("closed_at")

  @@index([status])
  @@index([userId])
  @@index([adminId])
  @@map("tickets")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ===== 银行卡绑定 =====
model BankCard {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  holderName String   @map("holder_name") @db.VarChar(32) // 持卡人姓名（须与实名认证一致）
  bankName   String   @map("bank_name") @db.VarChar(64)   // 银行名称
  cardNumber String   @map("card_number") @db.VarChar(32) // 卡号（完整存储，接口返回时脱敏）
  lastFour   String   @map("last_four") @db.VarChar(4)    // 后四位（用于展示）
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("bank_cards")
}

// ===== 实名认证 =====
model RealNameVerification {
  id              BigInt           @id @default(autoincrement())
  userId          BigInt           @unique @map("user_id")
  realName        String           @map("real_name") @db.VarChar(32)
  idCardNumber    String           @map("id_card_number") @db.VarChar(32) // 身份证号（完整存储，接口返回时脱敏）
  idCardLastFour  String           @map("id_card_last_four") @db.VarChar(4)
  status          RealNameStatus   @default(VERIFIED) // 提交并通过格式校验即视为 VERIFIED
  submittedAt     DateTime         @default(now()) @map("submitted_at")
  reviewedAt      DateTime?        @map("reviewed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("real_name_verifications")
}

enum RealNameStatus {
  PENDING
  VERIFIED
  REJECTED
}
