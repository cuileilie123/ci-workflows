# 微信小程序
WX_APP_ID=your_appid_here
WX_SECRET=your_secret_here
WX_MCH_ID=your_mch_id_here
WX_API_V3_KEY=your_v3_key_here
WX_PAY_PRIVATE_KEY=your_private_key_pem_here
WX_PAY_PUBLIC_KEY=your_public_key_pem_here
WX_PAY_NOTIFY_URL=https://your-domain.com/api/pay/notify

# 平台佣金分账接收方（独立的平台收款商户号）
# 启用后，订单支付成功时将 platformFee 分到该商户号；未配置则所有资金停留在 WX_MCH_ID
WX_PROFIT_SHARING_ENABLED=true
WX_PROFIT_SHARING_RECEIVER_MCH_ID=platform_receiver_mch_id_here
WX_PROFIT_SHARING_RECEIVER_NAME=平台佣金账户

# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=neighborhood_help
# Prisma 连接串（bff/prisma/schema.prisma 读取此变量）
DATABASE_URL=mysql://root:your_password_here@localhost:3306/neighborhood_help

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=generate_a_long_random_string_here
JWT_REFRESH_SECRET=generate_another_long_random_string_here

# 腾讯云 COS
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=neighborhood-help-1250000000
COS_REGION=ap-guangzhou

# 腾讯地图
MAP_KEY=your_map_key_here

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# Elasticsearch
ES_URL=http://localhost:9200

# MongoDB
MONGO_URL=mongodb://localhost:27017/neighborhood_help

# 前端 API 地址
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ===== 监控告警推送 =====
# 方案一：Server酱 Turbo（推送到个人微信）
# 申请地址: https://sct.ftqq.com/  登录后复制 SendKey
SERVERCHAN_SENDKEY=

# 方案二：Bark（推送到 iOS 通知）
# App Store 安装 Bark 后复制 DeviceKey
BARK_DEVICE_KEY=
# 如果自建了 Bark 服务器，改这里；默认用官方
# BARK_SERVER=https://api.day.app

# 告警标题前缀（带环境标记，避免多环境告警混在一起）
MONITOR_ALERT_PREFIX=[邻里互助生产环境]
